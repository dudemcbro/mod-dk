+void Player::InitTaxiNodesForLevel()
+{
+    uint32 taxiClass = getClass();
+
+    // Scripts can grant or deny the Death Knight starting flight paths through CLASS_CONTEXT_TAXI
+    if (IsClass(CLASS_DEATH_KNIGHT, CLASS_CONTEXT_TAXI))
+        taxiClass = CLASS_DEATH_KNIGHT;
+    else if (taxiClass == CLASS_DEATH_KNIGHT)
+        taxiClass = CLASS_NONE;
+
+    m_taxi.InitTaxiNodesForLevel(getRace(), taxiClass, GetLevel());
+}
